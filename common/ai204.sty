  \node[anchor=west,text=white,text width=16cm,align=left] at ([xshift=2cm,yshift=-16.3cm]current page.north west)
    {\Large #2};
  \node[anchor=west,text=white!85!gold,text width=16cm,align=left] at ([xshift=2cm,yshift=-18.6cm]current page.north west)
    {\large\itshape #3};
  \node[anchor=south west,text=white,align=left] at ([xshift=2cm,yshift=0.9cm]current page.south west)
